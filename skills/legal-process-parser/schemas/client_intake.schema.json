{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relatos recebidos, preservados sem confirmação documental",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entries": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "text", "conversation_reference"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "conversation_reference": {"type": "string", "minLength": 1},
        "supersedes": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
