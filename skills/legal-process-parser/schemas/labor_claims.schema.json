{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de pretensões trabalhistas v2 (teses candidatas dos dois polos)",
  "type": "object",
  "required": [
    "schema_version",
    "policy",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "thesis": {
      "type": "object",
      "required": [
        "id",
        "label",
        "authority_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[cd][0-9]+$"
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "authority_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "topic_id",
        "requirements",
        "policy",
        "claimant_theses",
        "defense_theses",
        "temporal_marker_ids",
        "typical_requests",
        "evidence",
        "calculation_profiles",
        "related_claims",
        "prescription"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "pattern": "^labor_details/[a-z_]+\\.md$"
        },
        "claimant_theses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/thesis"
          }
        },
        "defense_theses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/thesis"
          }
        },
        "temporal_marker_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "typical_requests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "calculation_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prescription": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
