{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Especialização trabalhista vinculada à revisão jurídica v4",
  "type": "object",
  "required": ["schema_version","corpus_revision","scope","relationships","contract_periods","collective_instruments","topic_assessments","evidence_checks","health_assessments","procedure_reviews","calculation_scope"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "corpus_revision": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "scope": {
      "type":"object","required":["mode","topic_ids","excluded_topics","represented_role","contextual_limitations"],
      "properties":{
        "mode":{"enum":["integral","targeted"]},"topic_ids":{"$ref":"#/$defs/ids"},
        "excluded_topics":{"type":"array","items":{"type":"object","required":["topic_id","reason"],"properties":{"topic_id":{"type":"string"},"reason":{"$ref":"#/$defs/text"}},"additionalProperties":false}},
        "represented_role":{"enum":["claimant","respondent","neutral"]},"contextual_limitations":{"$ref":"#/$defs/ids"}
      },"additionalProperties":false
    },
    "relationships":{"type":"array","items":{"$ref":"#/$defs/relationship"}},
    "contract_periods":{"type":"array","items":{"$ref":"#/$defs/period"}},
    "collective_instruments":{"type":"array","items":{"$ref":"#/$defs/instrument"}},
    "topic_assessments":{"type":"array","items":{"$ref":"#/$defs/topic"}},
    "evidence_checks":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "health_assessments":{"type":"array","items":{"$ref":"#/$defs/health"}},
    "procedure_reviews":{"type":"array","items":{"$ref":"#/$defs/procedure"}},
    "international_checks":{"type":"array","items":{"$ref":"#/$defs/international"}},
    "calculation_set":{"type":"object"},
    "calculation_scope":{
      "type":"object","required":["status","reason","title_fact_ids","title_scope_analysis"],
      "properties":{
        "status":{"enum":["not_requested","not_applicable","pending","calculated"]},"reason":{"$ref":"#/$defs/text"},
        "title_fact_ids":{"$ref":"#/$defs/ids"},"title_scope_analysis":{"type":"string"}
      },"additionalProperties":false
    }
  },
  "allOf":[{"if":{"properties":{"calculation_scope":{"properties":{"status":{"const":"calculated"}}}}},"then":{"required":["calculation_set"]}}],
  "additionalProperties":false,
  "$defs":{
    "text":{"type":"string","minLength":1},
    "ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "date":{"type":["string","null"],"format":"date"},
    "status":{"enum":["established","asserted","disputed","limited"]},
    "relationship":{
      "type":"object","required":["id","worker","employers","regime","category","territory","status","fact_ids","norm_ids","reason"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"worker":{"$ref":"#/$defs/text"},"employers":{"$ref":"#/$defs/ids"},
        "regime":{"enum":["clt","domestico","rural","temporario","aprendizagem","estagio","estatutario","autonomo","disputed","unknown"]},
        "category":{"type":"string"},"territory":{"type":"string"},"status":{"$ref":"#/$defs/status"},
        "fact_ids":{"$ref":"#/$defs/ids"},"norm_ids":{"$ref":"#/$defs/ids"},"reason":{"$ref":"#/$defs/text"}
      },"additionalProperties":false
    },
    "period":{
      "type":"object","required":["id","relationship_id","start","end","status","job","fact_ids","norm_ids","law_version_analysis","missing_information"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"relationship_id":{"$ref":"#/$defs/text"},"start":{"$ref":"#/$defs/date"},"end":{"$ref":"#/$defs/date"},
        "status":{"$ref":"#/$defs/status"},"job":{"type":"string"},"fact_ids":{"$ref":"#/$defs/ids"},"norm_ids":{"$ref":"#/$defs/ids"},
        "law_version_analysis":{"$ref":"#/$defs/text"},"missing_information":{"$ref":"#/$defs/ids"}
      },"additionalProperties":false
    },
    "instrument":{
      "type":"object","required":["id","norm_id","instrument_type","registration_reference","category_scope","territory_scope","employer_scope","effective_from","effective_until","clauses"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"norm_id":{"$ref":"#/$defs/text"},"instrument_type":{"enum":["CCT","ACT","aditivo","sentenca_normativa"]},
        "registration_reference":{"$ref":"#/$defs/text"},"category_scope":{"$ref":"#/$defs/ids"},"territory_scope":{"$ref":"#/$defs/ids"},"employer_scope":{"$ref":"#/$defs/ids"},
        "effective_from":{"type":"string","format":"date"},"effective_until":{"type":"string","format":"date"},
        "clauses":{"type":"array","minItems":1,"items":{"type":"object","required":["id","provision","quote","reason"],"properties":{
          "id":{"$ref":"#/$defs/text"},"provision":{"$ref":"#/$defs/text"},"quote":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"}
        },"additionalProperties":false}}
      },"additionalProperties":false
    },
    "check":{
      "type":"object","required":["check_id","status","fact_ids","norm_ids","reason"],
      "properties":{"check_id":{"$ref":"#/$defs/text"},"status":{"enum":["supported","disputed","pending","not_applicable"]},"fact_ids":{"$ref":"#/$defs/ids"},"norm_ids":{"$ref":"#/$defs/ids"},"reason":{"$ref":"#/$defs/text"}},
      "additionalProperties":false
    },
    "gap":{
      "type":"object","required":["description","action","effect"],
      "properties":{"description":{"$ref":"#/$defs/text"},"action":{"$ref":"#/$defs/text"},"effect":{"enum":["none","qualifies_conclusion","blocks_issue"]}},
      "additionalProperties":false
    },
    "topic":{
      "type":"object","required":["id","issue_id","topic_id","period_ids","fact_ids","norm_ids","request_ids","status","checks","burden","collective_checks","research_reason","strongest_objection","response","selection_reason","gaps"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"issue_id":{"$ref":"#/$defs/text"},"topic_id":{"$ref":"#/$defs/text"},
        "period_ids":{"$ref":"#/$defs/ids"},"fact_ids":{"$ref":"#/$defs/ids"},"norm_ids":{"$ref":"#/$defs/ids"},"request_ids":{"$ref":"#/$defs/ids"},
        "status":{"enum":["applicable","excluded","pending"]},"checks":{"type":"array","items":{"$ref":"#/$defs/check"}},
        "burden":{"type":"object","required":["holder","norm_ids","decision_fact_ids","reason"],"properties":{
          "holder":{"enum":["claimant","respondent","shared","dynamic","unknown","not_applicable"]},"norm_ids":{"$ref":"#/$defs/ids"},"decision_fact_ids":{"$ref":"#/$defs/ids"},"reason":{"$ref":"#/$defs/text"}
        },"additionalProperties":false},
        "collective_checks":{"type":"array","items":{"type":"object","required":["instrument_id","clause_ids","fit","reason"],"properties":{
          "instrument_id":{"$ref":"#/$defs/text"},"clause_ids":{"$ref":"#/$defs/ids"},"fit":{"enum":["applicable","excluded","pending"]},"reason":{"$ref":"#/$defs/text"}
        },"additionalProperties":false}},
        "research_reason":{"$ref":"#/$defs/text"},"strongest_objection":{"$ref":"#/$defs/text"},"response":{"$ref":"#/$defs/text"},
        "selection_reason":{"$ref":"#/$defs/text"},"gaps":{"type":"array","items":{"$ref":"#/$defs/gap"}}
      },"additionalProperties":false
    },
    "workday":{
      "type":"object","required":["clock_in","clock_out","break_minutes","fact_ids","expected_minutes"],
      "properties":{
        "clock_in":{"type":"string","format":"date-time"},"clock_out":{"type":"string","format":"date-time"},
        "break_minutes":{"type":"integer","minimum":0},"fact_ids":{"$ref":"#/$defs/ids"},
        "expected_minutes":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)?$"}
      },"additionalProperties":false
    },
    "evidence":{
      "type":"object","required":["id","topic_assessment_id","relationship_id","period_ids","document_type","sources","status","reason"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"topic_assessment_id":{"$ref":"#/$defs/text"},"relationship_id":{"$ref":"#/$defs/text"},"period_ids":{"$ref":"#/$defs/ids"},
        "document_type":{"enum":["CTPS","contract","payslip","timecard","bank","FGTS","rescission","collective","medical","deposition","communication","other"]},
        "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["fact_id","source_index"],"properties":{
          "fact_id":{"$ref":"#/$defs/text"},"source_index":{"type":"integer","minimum":0}
        },"additionalProperties":false}},
        "status":{"enum":["confirmed","disputed","limited"]},"reason":{"$ref":"#/$defs/text"},"working_day":{"$ref":"#/$defs/workday"}
      },"additionalProperties":false
    },
    "medical_check":{
      "type":"object","required":["status","fact_ids","reason"],
      "properties":{"status":{"enum":["supported","disputed","pending","excluded"]},"fact_ids":{"$ref":"#/$defs/ids"},"reason":{"$ref":"#/$defs/text"}},
      "additionalProperties":false
    },
    "health":{
      "type":"object","required":["id","issue_ids","relationship_id","period_ids","fact_ids","norm_ids","causation","concausation","incapacity","exposure","expertise_status","technical_questions","consequences_reason"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"issue_ids":{"$ref":"#/$defs/ids"},"relationship_id":{"$ref":"#/$defs/text"},"period_ids":{"$ref":"#/$defs/ids"},
        "fact_ids":{"$ref":"#/$defs/ids"},"norm_ids":{"$ref":"#/$defs/ids"},"causation":{"$ref":"#/$defs/medical_check"},"concausation":{"$ref":"#/$defs/medical_check"},
        "incapacity":{"$ref":"#/$defs/medical_check"},"exposure":{"$ref":"#/$defs/medical_check"},
        "expertise_status":{"enum":["present","pending","not_required_with_reason"]},"technical_questions":{"$ref":"#/$defs/ids"},"consequences_reason":{"$ref":"#/$defs/text"}
      },"additionalProperties":false
    },
    "deadline":{
      "type":"object","required":["event_date","days","include_event_day","mode","trigger_fact_id","norm_id","jurisdiction","calendar_norm_ids","holidays","suspensions","expected_due_date"],
      "properties":{
        "event_date":{"type":"string","format":"date"},"days":{"type":"integer","minimum":1,"maximum":10000},"include_event_day":{"type":"boolean"},
        "mode":{"enum":["business","calendar"]},"trigger_fact_id":{"$ref":"#/$defs/text"},"norm_id":{"$ref":"#/$defs/text"},"jurisdiction":{"$ref":"#/$defs/text"},
        "calendar_norm_ids":{"$ref":"#/$defs/ids"},"holidays":{"type":"array","uniqueItems":true,"items":{"type":"string","format":"date"}},
        "suspensions":{"type":"array","items":{"type":"object","required":["start","end","norm_id"],"properties":{
          "start":{"type":"string","format":"date"},"end":{"type":"string","format":"date"},"norm_id":{"$ref":"#/$defs/text"}
        },"additionalProperties":false}},"expected_due_date":{"type":"string","format":"date"}
      },"additionalProperties":false
    },
    "international":{
      "type":"object","required":["id","norm_id","country","ratification_status","effective_from","effective_until","domestic_norm_ids","status_norm_ids","reason"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"norm_id":{"$ref":"#/$defs/text"},"country":{"const":"BR"},
        "ratification_status":{"enum":["in_force","not_ratified","denounced","unknown"]},
        "effective_from":{"$ref":"#/$defs/date"},"effective_until":{"$ref":"#/$defs/date"},
        "domestic_norm_ids":{"$ref":"#/$defs/ids"},"status_norm_ids":{"$ref":"#/$defs/ids"},"reason":{"$ref":"#/$defs/text"}
      },"additionalProperties":false
    },
    "procedure":{
      "type":"object","required":["id","check_id","issue_ids","act_fact_ids","norm_ids","status","reason"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"check_id":{"$ref":"#/$defs/text"},"issue_ids":{"$ref":"#/$defs/ids"},"act_fact_ids":{"$ref":"#/$defs/ids"},"norm_ids":{"$ref":"#/$defs/ids"},
        "status":{"enum":["verified","limited","not_applicable"]},"reason":{"$ref":"#/$defs/text"},"deadline":{"$ref":"#/$defs/deadline"}
      },"additionalProperties":false
    }
  }
}
