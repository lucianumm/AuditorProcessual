{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucianumm/AuditorProcessual/schemas/legal_review.schema.json",
  "title": "Revisão jurídica estruturada pelo modelo",
  "description": "Contrato provider-neutral para análise e peças. A versão 3 registra escolha da medida, técnica de aplicação normativa e estratégia de teses por questão, preservando fontes, contrapontos e pendências delimitadas.",
  "type": "object",
  "required": ["corpus_revision", "task", "strategy", "reviewed_pages", "page_reviews", "facts", "client_records", "norms", "issues", "requests", "paragraphs", "research_closure", "unresolved"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "2.0", "3.0"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "page_reviews": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["page_id", "content_revision", "relevance", "findings", "fact_ids", "reviewed_by"], "properties": {
      "page_id": {"type": "string"}, "content_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "relevance": {"enum": ["relevant", "context", "technical", "blank"]},
      "findings": {"type": "string", "minLength": 1}, "fact_ids": {"type": "array", "items": {"type": "string"}}, "reviewed_by": {"type": "string", "minLength": 1}
    }}},
    "title": {"type": "string"},
    "corpus_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {"enum": ["analyze", "petition", "audit"]},
    "piece_type": {"enum": ["inicial", "contestacao", "replica", "pericia", "recurso", "cumprimento", "manifestacao"]},
    "piece_assessment": {"$ref": "#/$defs/piece_assessment"},
    "norm_applications": {"type": "array", "items": {"$ref": "#/$defs/norm_application"}},
    "theses": {"type": "array", "items": {"$ref": "#/$defs/thesis"}},
    "strategy": {
      "type": "object",
      "required": ["objective", "jurisdiction", "domain", "phase"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "represented_party": {"type": "string"}
      },
      "additionalProperties": true
    },
    "reviewed_pages": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}:[1-9][0-9]*$"},
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "client_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/client_record"}
    },
    "norms": {
      "type": "array",
      "items": {"$ref": "#/$defs/norm"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "requests": {
      "type": "array",
      "items": {"$ref": "#/$defs/request"}
    },
    "paragraphs": {
      "type": "array",
      "items": {"$ref": "#/$defs/paragraph"}
    },
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "decision_grounds": {"type": "array", "items": {"type": "object"}},
    "calculations": {"type": "array", "items": {"type": "object"}},
    "periods": {"type": "array", "items": {"type": "object"}},
    "research_closure": {
      "type": "object",
      "required": ["searched_topics", "stop_reason"],
      "properties": {
        "searched_topics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "stop_reason": {"type": "string", "minLength": 1},
        "excluded_sources": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "related_processes_reason": {"type": "string"},
    "unresolved": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "3.0"}}, "required": ["schema_version"]},
      "then": {
        "required": ["piece_assessment", "norm_applications", "theses"],
        "properties": {"unresolved": {"maxItems": 0}}
      }
    }
  ],
  "$defs": {
    "piece_assessment": {
      "type": "object",
      "required": ["status", "process_stage", "triggering_act", "represented_party", "objective", "selected_piece", "drafted_piece_type", "selection_reason", "alternatives_considered", "admissibility_checks", "deadline", "fact_ids", "norm_ids"],
      "properties": {
        "status": {"enum": ["selected", "no_immediate_action", "needs_material_information", "outside_scope"]},
        "process_stage": {"type": "string", "minLength": 1},
        "triggering_act": {"type": "string", "minLength": 1},
        "represented_party": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "selected_piece": {"type": ["string", "null"]},
        "drafted_piece_type": {"type": ["string", "null"], "enum": ["inicial", "contestacao", "replica", "pericia", "recurso", "cumprimento", "manifestacao", null]},
        "selection_reason": {"type": "string", "minLength": 1},
        "alternatives_considered": {"type": "array", "items": {"type": "object", "required": ["piece", "reason"], "properties": {"piece": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
        "admissibility_checks": {"type": "array", "items": {"type": "object", "required": ["requirement", "status", "reason"], "properties": {"requirement": {"type": "string", "minLength": 1}, "status": {"enum": ["satisfied", "unsatisfied", "uncertain", "not_applicable"]}, "reason": {"type": "string", "minLength": 1}, "fact_ids": {"type": "array", "items": {"type": "string"}}, "norm_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
        "deadline": {"type": "object", "required": ["status", "calculation_or_limitation", "fact_ids", "norm_ids"], "properties": {"status": {"enum": ["confirmed", "not_applicable", "needs_confirmation", "not_calculated"]}, "due_date": {"type": ["string", "null"], "format": "date"}, "calculation_or_limitation": {"type": "string", "minLength": 1}, "fact_ids": {"type": "array", "items": {"type": "string"}}, "norm_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "norm_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "norm_application": {
      "type": "object",
      "required": ["id", "issue_id", "norm_id", "method", "basis_for_use", "gap_or_remission", "similarities", "differences", "compatibility_analysis", "limits_and_contrary_authorities", "temporal_fit", "result"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "norm_id": {"type": ["string", "null"]},
        "method": {"enum": ["direct", "express_remission", "subsidiary", "supplementary", "analogy", "systemic_interpretation", "rejected", "not_required"]},
        "basis_for_use": {"type": "string", "minLength": 1},
        "gap_or_remission": {"type": "string", "minLength": 1},
        "similarities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "differences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "compatibility_analysis": {"type": "string", "minLength": 1},
        "limits_and_contrary_authorities": {"type": "string", "minLength": 1},
        "temporal_fit": {"type": "string", "minLength": 1},
        "result": {"enum": ["applied", "rejected", "limited", "pending", "no_other_regime"]}
      },
      "allOf": [
        {"if": {"properties": {"method": {"const": "analogy"}}, "required": ["method"]}, "then": {"properties": {"gap_or_remission": {"minLength": 1}, "similarities": {"minItems": 1}, "differences": {"minItems": 1}}}},
        {"if": {"properties": {"method": {"enum": ["subsidiary", "supplementary"]}}, "required": ["method"]}, "then": {"properties": {"gap_or_remission": {"minLength": 1}, "compatibility_analysis": {"minLength": 1}}}}
      ],
      "additionalProperties": true
    },
    "thesis": {
      "type": "object",
      "required": ["id", "issue_id", "characterization", "role", "proposition", "fact_ids", "norm_ids", "norm_application_ids", "request_ids", "requirements_analysis", "strongest_objection", "response", "procedural_compatibility", "evidential_limits", "expected_effect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "characterization": {"enum": ["consolidated", "contested", "analogical_proposal", "novel_proposal", "provisional", "not_advanced"]},
        "role": {"enum": ["principal", "subsidiary", "alternative", "not_pursued"]},
        "proposition": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "norm_ids": {"type": "array", "items": {"type": "string"}},
        "norm_application_ids": {"type": "array", "items": {"type": "string"}},
        "request_ids": {"type": "array", "items": {"type": "string"}},
        "requirements_analysis": {"type": "string", "minLength": 1},
        "strongest_objection": {"type": "string", "minLength": 1},
        "response": {"type": "string", "minLength": 1},
        "procedural_compatibility": {"type": "string", "minLength": 1},
        "evidential_limits": {"type": "string", "minLength": 1},
        "expected_effect": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["id", "code", "category", "severity", "status", "scope", "target_ids", "description", "impact", "delivery_effect", "required_action", "attempt_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "category": {"enum": ["technical", "coverage", "evidence", "legal", "procedural", "editorial"]},
        "severity": {"enum": ["blocking", "material", "advisory"]},
        "status": {"enum": ["open", "in_progress", "resolved", "accepted_limitation"]},
        "scope": {"enum": ["execution", "document", "page", "fact", "norm", "issue", "request", "paragraph"]},
        "target_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "delivery_effect": {"enum": ["none", "qualifies_conclusion", "blocks_assertion", "blocks_issue", "blocks_delivery"]},
        "required_action": {"type": "string", "minLength": 1},
        "attempt_ids": {"type": "array", "items": {"type": "string"}},
        "resolution": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["source_sha256", "pdf_page", "document_id", "quote"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pdf_page": {"type": "integer", "minimum": 1},
        "document_id": {"type": "string", "minLength": 1},
        "piece": {"type": "string"},
        "court_page": {"type": ["integer", "null"]},
        "layer": {"enum": ["text", "vision"]},
        "image_id": {"type": "string"},
        "quote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "client_record": {
      "type": "object",
      "required": ["id", "text", "conversation_reference"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "conversation_reference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": ["id", "text", "nature", "origin", "support"],
      "properties": {
        "support": {"type": "object", "required": ["assessment", "reason", "reviewed_by"], "properties": {"assessment": {"enum": ["direct", "inference", "client_account", "disputed"]}, "reason": {"type": "string", "minLength": 1}, "reviewed_by": {"type": "string", "minLength": 1}}},
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "nature": {"enum": ["fato", "alegacao", "prova", "decisao", "inferencia", "lacuna"]},
        "origin": {"enum": ["client", "document"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "client_record_id": {"type": "string"},
        "evidence_needed": {"type": "string"}
      },
      "additionalProperties": true
    },
    "norm": {
      "type": "object",
      "required": ["id", "kind", "url", "accessed_on", "title", "provision", "quote", "official_text", "temporal_analysis", "jurisdiction", "hierarchy", "case_fit", "reviewed_by", "status"],
      "anyOf": [{"required": ["capture_id"]}, {"required": ["source_record_id"]}],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["constitution", "statute", "regulation", "local_act", "precedent", "administrative_act", "other"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "capture_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "accessed_on": {"type": "string", "format": "date"},
        "title": {"type": "string", "minLength": 1},
        "provision": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "official_text": {"type": "string", "minLength": 1},
        "temporal_analysis": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "minLength": 1},
        "hierarchy": {"type": "string", "minLength": 1},
        "case_fit": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "observed"]},
        "court": {"type": "string"},
        "case_number": {"type": "string"},
        "decision_date": {"type": "string", "format": "date"},
        "holding": {"type": "string"},
        "binding_status": {"type": "string"},
        "distinguishing": {"type": "string"},
        "current_status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "required": ["id", "fact_ids", "norm_ids", "question", "subsumption", "counterargument", "response", "conclusion", "evidence_assessment", "requirements", "research"],
      "properties": {
        "research": {"type": "object", "required": ["material_law", "procedure", "temporal_scope", "jurisdiction", "contrary_authorities", "closure_reason"], "additionalProperties": {"type": "string", "minLength": 1}},
        "id": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "norm_ids": {"type": "array", "items": {"type": "string"}},
        "analysis_status": {"enum": ["concluded", "qualified", "undetermined"]},
        "request_ids": {"type": "array", "items": {"type": "string"}},
        "question": {"type": "string", "minLength": 1},
        "subsumption": {"type": "string", "minLength": 1},
        "counterargument": {"type": "string", "minLength": 1},
        "response": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string", "minLength": 1},
        "evidence_assessment": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": ["id", "issue_ids", "fact_ids", "origin", "text", "compatibility"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "issue_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "fact_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "origin": {"enum": ["existing", "user", "proposed"]},
        "text": {"type": "string", "minLength": 1},
        "compatibility": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "paragraph": {
      "type": "object",
      "required": ["id", "section", "text", "fact_ids", "norm_ids", "issue_ids", "request_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "norm_ids": {"type": "array", "items": {"type": "string"}},
        "issue_ids": {"type": "array", "items": {"type": "string"}},
        "request_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
