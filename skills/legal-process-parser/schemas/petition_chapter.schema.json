{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected pleading chapter; authored review is not a merit certificate",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "issue_ids",
    "thesis_ids",
    "request_ids",
    "paragraphs",
    "semantic_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "issue_ids": {
      "$ref": "#/$defs/selected"
    },
    "thesis_ids": {
      "$ref": "#/$defs/selected"
    },
    "request_ids": {
      "$ref": "#/$defs/selected"
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "fact_ids",
          "norm_ids",
          "issue_ids",
          "request_ids",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "$ref": "#/$defs/ids"
          },
          "norm_ids": {
            "$ref": "#/$defs/ids"
          },
          "issue_ids": {
            "$ref": "#/$defs/selected"
          },
          "request_ids": {
            "$ref": "#/$defs/ids"
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_id",
                "fields"
              ],
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "actor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "action": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "object": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "scope": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "period_start": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "period_end": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "amount": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "currency": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "polarity": {
                      "enum": [
                        "affirmed",
                        "denied",
                        "uncertain"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "semantic_review": {
      "type": "object",
      "required": [
        "reviewer",
        "requirements",
        "contrary_evidence",
        "applicability",
        "requests_consistency"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "contrary_evidence": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "requests_consistency": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
