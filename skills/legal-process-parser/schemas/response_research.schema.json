{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-response consultation and attributed interpretation",
  "type": "object",
  "required": [
    "schema_version",
    "response_id",
    "issue_ids",
    "artifact_hash",
    "research_revision",
    "checked_at",
    "citations",
    "causes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "response_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "issue_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "research_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "norm_id",
          "source_record_id",
          "quote",
          "applicability_analysis",
          "version_analysis"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "norm_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "applicability_analysis": {
            "type": "string",
            "minLength": 1
          },
          "version_analysis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "issue_id",
          "paragraph_ids",
          "fact_ids",
          "norm_ids",
          "request_ids",
          "requirements_analysis",
          "exceptions_analysis",
          "contrary_analysis",
          "consequence",
          "status",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "paragraph_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "norm_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "request_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirements_analysis": {
            "type": "string",
            "minLength": 1
          },
          "exceptions_analysis": {
            "type": "string",
            "minLength": 1
          },
          "contrary_analysis": {
            "type": "string",
            "minLength": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "qualified",
              "pending"
            ]
          },
          "limitation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "parameter_review": {
      "type": "object"
    },
    "precedents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "norm_id",
          "issue_id",
          "holding_source_id",
          "status_source_id",
          "holding_excerpt",
          "status_excerpt",
          "merit_analysis",
          "process_analysis",
          "effect_analysis",
          "modulation_analysis",
          "case_comparison",
          "contrary_analysis"
        ],
        "properties": {
          "norm_id": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "holding_source_id": {
            "type": "string",
            "minLength": 1
          },
          "status_source_id": {
            "type": "string",
            "minLength": 1
          },
          "holding_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "status_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "merit_analysis": {
            "type": "string",
            "minLength": 1
          },
          "process_analysis": {
            "type": "string",
            "minLength": 1
          },
          "effect_analysis": {
            "type": "string",
            "minLength": 1
          },
          "modulation_analysis": {
            "type": "string",
            "minLength": 1
          },
          "case_comparison": {
            "type": "string",
            "minLength": 1
          },
          "contrary_analysis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
