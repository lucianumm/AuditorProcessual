{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucianumm/AuditorProcessual/schemas/vision_review.schema.json",
  "title": "Provider-neutral semantic vision review",
  "type": "object",
  "required": ["schema_version", "source_sha256", "pages", "images"],
  "properties": {
    "schema_version": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {"type": "string"},
    "pages": {"type": "object", "additionalProperties": {
      "type": "object",
      "required": ["render_sha256", "description_source", "outcome"],
      "properties": {
        "render_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "description_source": {"enum": ["vision_model", "human_review", "external_review"]},
        "outcome": {"enum": ["completed", "blank", "image_only", "unreadable"]},
        "semantic_description": {"type": "string"},
        "transcription": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"outcome": {"enum": ["blank", "image_only"]}}, "required": ["outcome"]},
                 "then": {"properties": {"semantic_description": {"minLength": 1}}, "required": ["semantic_description"]}}]
    }},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image_id", "semantic_description", "description_source"],
        "properties": {
          "image_id": {"type": "string"},
          "semantic_description": {"type": "string", "minLength": 1},
          "description_source": {"enum": ["vision_model", "human_review", "external_review"]},
          "asset_class": {"enum": ["visual_asset", "technical_artifact", "qr_code", "logo", "document_scan", "photo", "unknown"]},
          "relevant": {"type": "boolean"},
          "visible_text": {"type": "string"},
          "objects": {"type": "array"},
          "people": {"type": "array"},
          "tables": {"type": "array"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
